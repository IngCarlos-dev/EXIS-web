---
import "../styles/global.css";
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/webp" href="https://unitropico.edu.co/wp-content/uploads/2026/06/Logo-Simbolo-Unitropico-Casanare-Bronce.webp" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | EXIS 2026-A</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  </head>
  <body class="min-h-screen bg-[#F8FAFC] text-slate-900 font-sans selection:bg-exis-primary selection:text-white">
    <header class="sticky top-0 z-40 w-full backdrop-blur-md bg-white/80 border-b border-slate-200/60">
      <div class="container mx-auto px-6 py-4 flex justify-between items-center">
        <a href="/" class="flex items-center gap-3 group">
          <img 
            src="https://unitropico.edu.co/wp-content/uploads/2026/04/logo-png-768x384.png" 
            alt="Logo Unitrópico" 
            class="h-10 w-auto object-contain transition-transform group-hover:scale-105 duration-300"
          />
          <div class="h-8 w-[1px] bg-slate-200"></div>
          <div>
            <h1 class="text-2xl font-black tracking-tighter text-exis-primary">EXIS <span class="text-exis-secondary">2026-A</span></h1>
            <p class="text-[10px] uppercase tracking-[0.2em] font-bold text-slate-400 -mt-1">Innovation Expo</p>
          </div>
        </a>
        <nav class="flex items-center gap-4">
          <a href="https://vota-exis.sistemasunitropico.com/" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 px-5 py-2 rounded-full bg-exis-secondary/10 text-sm font-bold text-exis-secondary hover:bg-exis-secondary hover:text-white transition-all duration-300 shadow-sm border border-exis-secondary/20 hover:border-exis-secondary hover:shadow-md">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 12 2 2 4-4"/><path d="M5 7c0-1.1.9-2 2-2h10a2 2 0 0 1 2 2v12H5V7Z"/><path d="M22 19H2"/></svg>
            Votar
          </a>
          <a href="/dashboard" class="flex items-center gap-2 px-5 py-2 rounded-full bg-slate-50 text-sm font-bold text-slate-700 hover:bg-exis-primary hover:text-white transition-all duration-300 shadow-sm border border-slate-200 hover:border-exis-primary hover:shadow-md">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="7" height="9" x="3" y="3" rx="1"/><rect width="7" height="5" x="14" y="3" rx="1"/><rect width="7" height="9" x="14" y="12" rx="1"/><rect width="7" height="5" x="3" y="16" rx="1"/></svg>
            Admin
          </a>
        </nav>
      </div>
    </header>

    <main class="container mx-auto px-6 py-16">
      <slot />
    </main>

    <Footer />
  </body>
</html>
